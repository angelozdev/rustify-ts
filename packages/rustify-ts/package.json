{
  "name": "rustify-ts",
  "version": "2.0.0",
  "description": "Typed error handling for TypeScript: honest types AND honest runtime. Ok / Fail / Defect with causal traces.",
  "license": "MIT",
  "author": "Angelo Zambrano",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "size": "tsdown && size-limit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:invariants": "tsdown && node --expose-gc bench/invariants/i1-happy-alloc.mjs",
    "bench:i4": "tsdown && node bench/invariants/i4-check.mjs",
    "bench:types": "node bench/types/check-time.mjs",
    "bench:compare": "tsdown && node bench/compare/run.mjs",
    "bench:all": "pnpm bench:invariants && pnpm bench:i4 && pnpm bench:types && pnpm bench:compare"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelozdev/rustify-ts.git",
    "directory": "packages/rustify-ts"
  },
  "homepage": "https://github.com/angelozdev/rustify-ts/tree/main/packages/rustify-ts#readme",
  "bugs": {
    "url": "https://github.com/angelozdev/rustify-ts/issues"
  },
  "keywords": [
    "error-handling",
    "result",
    "outcome",
    "typescript",
    "neverthrow",
    "typed-errors",
    "trace"
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "11.2.0",
    "fast-check": "4.9.0",
    "mitata": "1.0.34",
    "neverthrow": "8.2.0",
    "size-limit": "11.2.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
