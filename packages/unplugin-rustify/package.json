  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/types": "7.29.7",
    "@types/babel__core": "7.20.5",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "22.20.1",
    "rollup": "4.62.2",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
